# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Skill eval runs: generated outputs, regenerate with the eval harness.
# evals/ and fixtures/ stay tracked so runs can be reproduced.
dependency-audit-workspace/iteration-*/

# Fixture build output (Gradle caches, Maven target/). Fixtures track obj/ on
# purpose (NuGet restore output the audit reads), so only these are ignored.
dependency-audit-workspace/fixtures/**/.gradle/
dependency-audit-workspace/fixtures/**/target/

# Local audit outputs
dependency-report.json
dependency-report.html
!samples/dependency-report.json
!samples/dependency-report.html

