<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>__TITLE__</title>
<style>
/* Self-contained: system fonts, no external requests. Order: header, summary, what was checked,
   vulnerabilities, dependencies, suppressed, footer. */
:root {
  --bg: #f5f6f8; --surface: #ffffff; --sunken: #f0f2f5; --fg: #18212b; --muted: #5d6875; --line: #dde2e7;
  --accent: #0b5cad;
  --sev-critical: #a8173a; --sev-high: #b5470b; --sev-medium: #8a6400; --sev-low: #2a63a6; --sev-info: #626c78;
  --ok: #1f7a4a;
  --font-ui: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, "Cascadia Code", "SF Mono", Consolas, "Liberation Mono", monospace;
  --radius: 8px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f1419; --surface: #161d24; --sunken: #121820; --fg: #e4e9ee; --muted: #9aa6b2; --line: #28323c; --accent: #73b4ec;
    --sev-critical: #ff6f8a; --sev-high: #ff9659; --sev-medium: #e6bb4a; --sev-low: #77b1f3; --sev-info: #9ea8b4; --ok: #5fd090;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0f1419; --surface: #161d24; --sunken: #121820; --fg: #e4e9ee; --muted: #9aa6b2; --line: #28323c; --accent: #73b4ec;
  --sev-critical: #ff6f8a; --sev-high: #ff9659; --sev-medium: #e6bb4a; --sev-low: #77b1f3; --sev-info: #9ea8b4; --ok: #5fd090;
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 var(--font-ui);
  padding: 32px max(16px, env(safe-area-inset-right, 0px)) 56px max(16px, env(safe-area-inset-left, 0px));
}
.wrap { max-width: 1040px; margin: 0 auto; display: grid; gap: 40px; }
h1, h2, h3 { margin: 0; line-height: 1.25; text-wrap: balance; }
h1 { font-size: 1.85rem; font-weight: 650; letter-spacing: -0.01em; }
h2 { font-size: 1.25rem; font-weight: 650; }
h3 { font-size: 0.95rem; font-weight: 650; }
p { margin: 0; }
a { color: var(--accent); }
.mono { font-family: var(--font-mono); font-size: 0.9em; }
.muted { color: var(--muted); }
.small { font-size: 0.86rem; }
.num { font-variant-numeric: tabular-nums; }
.label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
section { display: grid; gap: 16px; min-width: 0; }
.section-head { display: grid; gap: 4px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; min-width: 0; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.banner { border: 1px dashed var(--line); border-radius: var(--radius); padding: 10px 14px; font-size: 0.86rem; color: var(--muted); }
.banner b { color: var(--fg); }
.banner-error { border: 1px solid var(--sev-critical); border-left-width: 4px; color: var(--fg); background: color-mix(in srgb, var(--sev-critical) 7%, var(--surface)); }
.banner-error ul { margin: 6px 0 0; padding-left: 18px; }

/* severity and status colours: always paired with a text label */
.sev-critical { --c: var(--sev-critical); } .sev-high { --c: var(--sev-high); } .sev-medium { --c: var(--sev-medium); }
.sev-low { --c: var(--sev-low); } .sev-info { --c: var(--sev-info); } .sev-none { --c: var(--ok); }
.st-supported { --c: var(--ok); } .st-security-only { --c: var(--sev-medium); } .st-end-of-life { --c: var(--sev-critical); }
.st-deprecated { --c: var(--sev-high); } .st-unmaintained { --c: var(--sev-high); } .st-unknown { --c: var(--sev-info); }
.pill { display: inline-flex; align-items: center; justify-content: center; min-width: 76px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--c); background: color-mix(in srgb, var(--c) 12%, transparent); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); border-radius: 999px; padding: 2px 10px; white-space: nowrap; }
.status { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; color: var(--c); white-space: nowrap; }
.status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex: none; }

/* header */
header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px 24px; flex-wrap: wrap; }
.head-main { display: grid; gap: 6px; min-width: 0; }
.meta { display: flex; flex-wrap: wrap; gap: 4px 8px; color: var(--muted); font-size: 0.9rem; }
.meta > span + span::before { content: "·"; margin-right: 8px; }
.risk { display: grid; gap: 2px; justify-items: end; text-align: right; }
.risk .pill { font-size: 0.95rem; padding: 6px 16px; }

/* summary */
.lead { font-size: 1.15rem; line-height: 1.5; max-width: 70ch; }
.stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.stat { display: grid; gap: 6px; align-content: start; }
.stat .n { font-size: 2.1rem; font-weight: 700; line-height: 1; }
.stat .detail { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 0.88rem; color: var(--muted); }
.stat .detail b { color: var(--c, var(--fg)); font-weight: 600; }
.stat.attention { border-left: 4px solid var(--c); }
ol.actions { margin: 0; padding: 0; list-style: none; counter-reset: a; display: grid; gap: 10px; }
ol.actions li { counter-increment: a; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: baseline; }
ol.actions li::before { content: counter(a); font-weight: 700; color: var(--accent); text-align: center; border: 1.5px solid var(--accent); border-radius: 50%; width: 24px; height: 24px; line-height: 21px; font-size: 0.82rem; }
.ref { font-family: var(--font-mono); font-size: 0.8rem; white-space: nowrap; }
details.help > summary { cursor: pointer; color: var(--accent); font-size: 0.9rem; width: fit-content; }
.help-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px 28px; padding-top: 12px; }
.help-col { display: grid; gap: 8px; align-content: start; min-width: 0; }
.help-grid dl { margin: 0; display: grid; gap: 6px; font-size: 0.88rem; }
.help-grid dt { margin-top: 4px; }
.help-grid dd { margin: 0; color: var(--muted); }

/* what was checked */
.checked { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center; }
.check-ok { color: var(--ok); font-weight: 600; }
.check-ok::before { content: "✓ "; }
.gap { color: var(--sev-medium); font-weight: 600; }
.gap::before { content: "! "; }
details.more > summary { cursor: pointer; color: var(--accent); font-size: 0.88rem; width: fit-content; margin-top: 10px; }
details.more .more-body { display: grid; gap: 8px; padding-top: 10px; font-size: 0.88rem; }

/* filters */
.controls { display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; }
.controls input[type="search"], .controls select {
  font: inherit; font-size: 0.9rem; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; min-width: 0; }
.controls input[type="search"] { flex: 1 1 220px; max-width: 300px; }
.toggle { font: inherit; font-size: 0.85rem; cursor: pointer; border: 1px solid var(--line); background: var(--surface); color: var(--muted); border-radius: 999px; padding: 4px 12px; }
.toggle[aria-pressed="true"] { color: var(--c); border-color: var(--c); background: color-mix(in srgb, var(--c) 10%, var(--surface)); font-weight: 600; }
.toggle:disabled { opacity: 0.45; cursor: default; }
.count { margin-left: auto; font-size: 0.85rem; color: var(--muted); }

/* findings */
.findings { display: grid; gap: 10px; }
details.finding { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: var(--radius); }
details.finding > summary { list-style: none; cursor: pointer; padding: 14px 16px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 4px 14px; align-items: center; }
details.finding > summary::-webkit-details-marker { display: none; }
.f-title { font-weight: 600; }
.f-sub { grid-column: 2; display: flex; flex-wrap: wrap; gap: 2px 14px; font-size: 0.88rem; color: var(--muted); }
.f-sub .fix-hint { color: var(--fg); }
.f-side { grid-column: 3; grid-row: 1 / 3; display: flex; align-items: center; gap: 10px; }
.reach-badge { font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
.reach-reachable { color: var(--sev-critical); } .reach-not-reachable { color: var(--ok); } .reach-unknown { color: var(--muted); font-weight: 500; }
.chev { width: 9px; height: 9px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(45deg); transition: transform .15s; }
details[open] > summary .chev { transform: rotate(225deg); }
.f-body { border-top: 1px solid var(--line); padding: 18px 16px 20px; display: grid; gap: 18px; }
.f-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 28px; }
.block { display: grid; gap: 6px; align-content: start; }
.block p { max-width: 70ch; }
.fix { border-left: 3px solid var(--ok); padding-left: 12px; }
.tech { background: var(--sunken); border-radius: 6px; padding: 12px 14px; }
.tech dl { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 18px; font-size: 0.86rem; }
.tech dt { color: var(--muted); }
.tech dd { margin: 0; overflow-wrap: anywhere; }
.links { display: flex; flex-wrap: wrap; gap: 4px 12px; }
pre.snippet { margin: 0; background: var(--sunken); border: 1px solid var(--line); border-radius: 6px; padding: 10px 0; overflow-x: auto; font: 0.84rem/1.55 var(--font-mono); }
pre.snippet .row { display: block; padding-right: 12px; }
pre.snippet .hit { background: color-mix(in srgb, var(--sev-high) 16%, transparent); }
pre.snippet .ln { display: inline-block; width: 3.4em; padding-right: 1em; text-align: right; color: var(--muted); user-select: none; }
.empty { padding: 20px; text-align: center; color: var(--muted); }

/* dependencies */
.support-bar { display: flex; height: 12px; border-radius: 6px; overflow: hidden; background: var(--sunken); }
.support-bar span { background: var(--c); }
.support-bar span + span { border-left: 2px solid var(--surface); }
.legend { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.88rem; }
.legend .zero { opacity: 0.55; }
.legend b { font-variant-numeric: tabular-nums; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
.tech-card { display: grid; gap: 6px; align-content: start; padding: 16px; }
.tech-card.oos { border-color: color-mix(in srgb, var(--sev-critical) 50%, var(--line)); box-shadow: inset 4px 0 0 var(--sev-critical); }
.tech-card .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.tech-card .name { font-weight: 650; font-size: 1.05rem; }
.tech-card .why { font-size: 0.86rem; color: var(--muted); }
.tech-card .where { font-size: 0.78rem; color: var(--muted); overflow-wrap: anywhere; }
.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
th, td { text-align: left; padding: 9px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
tbody tr:last-child td { border-bottom: 0; }
th { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); background: var(--sunken); white-space: nowrap; }
th button { all: unset; cursor: pointer; }
th button:focus-visible { outline: 2px solid var(--accent); }
th[aria-sort="ascending"], th[aria-sort="descending"] { color: var(--accent); }
td .sub { font-size: 0.78rem; color: var(--muted); margin-top: 2px; }
tr.attn td:first-child { box-shadow: inset 3px 0 0 var(--c); }

details.plain { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
details.plain > summary { cursor: pointer; padding: 12px 16px; font-weight: 600; }
details.plain .inner { border-top: 1px solid var(--line); }
details.plain table { border: 0; }

footer { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 0.8rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 14px; }

.noscript { display: grid; gap: 14px; }

@media (max-width: 760px) {
  h1 { font-size: 1.5rem; }
  .stats, .f-cols { grid-template-columns: minmax(0, 1fr); }
  .risk { justify-items: start; text-align: left; }
  details.finding > summary { grid-template-columns: minmax(0, 1fr) auto; }
  details.finding > summary .pill { justify-self: start; }
  .f-title, .f-sub { grid-column: 1 / -1; }
  .f-side { grid-column: 2; grid-row: 1; }
  .count { margin-left: 0; width: 100%; }
}
@media (prefers-reduced-motion: reduce) { .chev { transition: none; } }
@media print {
  body { background: #fff; padding: 0; }
  .controls, details.help > summary, .chev { display: none; }
  .card, details.finding, details.plain { break-inside: avoid; }
}
</style>
</head>
<body>
<div class="wrap">
  <div class="banner" id="sample-banner" hidden><b>Sample report.</b> The project and scan are fictional. Advisory IDs and support statuses are real public data written from memory to show the format; a real run takes them from OSV.dev, endoflife.date, the package registries or a scanner.</div>
__VALIDATION__

  <header>
    <div class="head-main">
      <div class="label">Dependency audit</div>
      <h1 id="proj-name">…</h1>
      <div class="meta" id="head-meta"></div>
    </div>
    <div class="risk" id="risk"></div>
  </header>

__NOSCRIPT__

  <section aria-labelledby="h-summary" id="summary">
    <h2 id="h-summary" class="label" style="letter-spacing:0.06em">Summary</h2>
    <p class="lead" id="headline"></p>
    <div class="stats" id="stats"></div>
    <div class="card" style="display:grid;gap:14px">
      <h3>What to do first</h3>
      <ol class="actions" id="actions"></ol>
    </div>
    <details class="help">
      <summary>How to read this report</summary>
      <div class="help-grid" id="help"></div>
    </details>
  </section>

  <section aria-labelledby="h-checked">
    <div class="section-head"><h2 id="h-checked">What was checked</h2><p class="muted small" id="scope-line"></p></div>
    <div class="card">
      <div class="checked" id="checked"></div>
      <details class="more"><summary>Tools and sources</summary><div class="more-body" id="tools"></div></details>
    </div>
  </section>

  <section aria-labelledby="h-findings">
    <div class="section-head"><h2 id="h-findings">Vulnerabilities</h2><p class="muted small">Most severe first. Open a row for what it means, whether your code is affected, and how to fix it.</p></div>
    <div class="controls">
      <div class="controls" id="sev-filters" role="group" aria-label="Severity"></div>
      <select id="f-cat" aria-label="Type"></select>
      <input type="search" id="f-search" placeholder="Search package, title or ID" aria-label="Search vulnerabilities">
      <span class="count" id="find-count"></span>
    </div>
    <div class="findings" id="findings"></div>
  </section>

  <section aria-labelledby="h-inventory">
    <div class="section-head"><h2 id="h-inventory">Dependencies</h2><p class="muted small" id="inv-line"></p></div>
    <div class="card" style="display:grid;gap:12px">
      <h3>Support status</h3>
      <div class="support-bar" id="support-bar" role="img"></div>
      <div class="legend" id="legend"></div>
    </div>
    <div class="cards" id="tech-cards"></div>
    <div class="controls">
      <input type="search" id="lib-search" placeholder="Search packages" aria-label="Search packages">
      <select id="lib-show" aria-label="Which packages">
        <option value="direct">Direct dependencies</option>
        <option value="attention">Needs attention</option>
        <option value="all">All, including transitive</option>
      </select>
      <select id="lib-scope" aria-label="Scope"><option value="">Any scope</option></select>
      <span class="count" id="lib-count"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr id="lib-head"></tr></thead>
        <tbody id="lib-body"></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-suppressed">
    <details class="plain">
      <summary id="h-suppressed">Suppressed findings</summary>
      <div class="inner table-wrap" style="border:0;border-radius:0">
        <table><thead><tr><th>Finding</th><th>Package</th><th>Location</th><th>Why it was suppressed</th></tr></thead><tbody id="suppressed"></tbody></table>
      </div>
    </details>
  </section>

  <footer id="footer"></footer>
</div>

<script id="report-data" type="application/json">
__DATA__
</script>
<script>
(function () {
  "use strict";
  var R = JSON.parse(document.getElementById("report-data").textContent);
  var SEV = ["critical", "high", "medium", "low", "info"];
  var SEV_RANK = { critical: 0, high: 1, medium: 2, low: 3, info: 4 };
  var CONF_RANK = { high: 0, medium: 1, low: 2 };
  var CAT_LABEL = { dependency: "Vulnerable package", support: "Out of support", integrity: "Report integrity" };
  var CHECK_LABEL = { inventory: "Dependency inventory", support: "Support status", sca: "Known vulnerabilities" };
  var STATUS = ["end-of-life", "deprecated", "unmaintained", "security-only", "unknown", "supported"];
  var STATUS_LABEL = { "supported": "Supported", "security-only": "Security fixes only", "end-of-life": "End of life", "deprecated": "Deprecated", "unmaintained": "Unmaintained", "unknown": "Unknown" };
  var STATUS_HELP = {
    "end-of-life": "The maintainers have stopped releasing fixes for this version, including security fixes.",
    "deprecated": "The package registry marks this package or version as deprecated.",
    "unmaintained": "The project is archived or abandoned and has had no release for a long time.",
    "security-only": "Still gets security fixes, but nothing else. Plan an upgrade.",
    "unknown": "No source said either way, for example because the project publishes no support policy.",
    "supported": "No end-of-life, deprecation or archive notice was found."
  };
  var SEV_HELP = {
    critical: "Exploitable with serious impact. Fix immediately.",
    high: "Likely exploitable or a runtime that no longer gets fixes. Fix soon.",
    medium: "Exploitable only in some conditions. Schedule a fix.",
    low: "Limited impact. Fix when convenient.",
    info: "Worth knowing; no direct risk."
  };
  var REACH = {
    "reachable": ["Used by your code", "Your code calls the affected part of the package."],
    "not-reachable": ["Not called by your code", "The affected function wasn't found in your code. Upgrade anyway: this can change."],
    "unknown": ["Use not confirmed", "It couldn't be determined whether your code uses the affected part."]
  };

  // DOM helper: strings become text nodes, so repository content is never parsed as HTML.
  function h(tag, attrs) {
    var el = document.createElement(tag);
    if (attrs) for (var k in attrs) {
      if (attrs[k] == null || attrs[k] === false) continue;
      if (k === "class") el.className = attrs[k];
      else if (k === "text") el.textContent = attrs[k];
      else el.setAttribute(k, attrs[k]);
    }
    for (var i = 2; i < arguments.length; i++) {
      var c = arguments[i];
      if (c == null || c === false) continue;
      if (Array.isArray(c)) c.forEach(function (x) { if (x != null && x !== false) el.append(x); });
      else el.append(c);
    }
    return el;
  }
  function $(id) { return document.getElementById(id); }
  function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
  function plural(n, one, many) { return n + " " + (n === 1 ? one : (many || one + "s")); }
  function fmtDate(iso) {
    var d = new Date(iso);
    if (isNaN(d)) return iso;
    var m = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][d.getUTCMonth()];
    return d.getUTCDate() + " " + m + " " + d.getUTCFullYear() + ", " + d.toISOString().slice(11, 16) + " UTC";
  }
  function pill(sev, text) { return h("span", { class: "pill sev-" + sev, text: text || sev }); }
  function statusEl(s) {
    var st = (s && s.status) || "unknown";
    return h("span", { class: "status st-" + st, text: STATUS_LABEL[st] + (s && s.eol_date ? " since " + s.eol_date : "") });
  }
  function safeUrl(u) { return /^https?:\/\//i.test(u) ? u : null; }
  function withRefs(text) {
    // Turn "(F-001)" style references into links that open the finding.
    var out = [];
    String(text).split(/(F-\d{3,})/).forEach(function (part) {
      out.push(/^F-\d{3,}$/.test(part) ? h("a", { href: "#" + part, class: "ref", "data-open": part, text: part }) : part);
    });
    return out;
  }

  var allPkgs = R.inventory.runtimes.concat(R.inventory.libraries);
  var byId = {}; allPkgs.forEach(function (p) { byId[p.id] = p; });

  // Header
  if (R.sample) $("sample-banner").hidden = false;
  document.title = (R.target.name || "Project") + " · Dependency audit";
  $("proj-name").textContent = R.target.name || R.target.path;
  var vcs = R.target.vcs;
  [vcs ? h("span", null, "Commit ", h("span", { class: "mono", text: vcs.commit }), vcs.branch ? " on " + vcs.branch : "", vcs.dirty ? " (with uncommitted changes)" : "") : null,
   h("span", { text: "Scanned " + fmtDate(R.generated_at) }),
   h("span", { text: R.scan.mode === "offline" ? "Offline: vulnerabilities not verified" : "Online" })
  ].forEach(function (x) { if (x) $("head-meta").append(x); });
  var risk = R.summary.risk_rating;
  $("risk").append(h("span", { class: "label", text: "Overall risk" }), pill(risk, risk === "none" ? "No risk found" : risk));

  // Summary
  $("headline").textContent = R.summary.headline;
  var counts = R.summary.counts, total = 0;
  SEV.forEach(function (s) { total += counts[s] || 0; });
  var worst = SEV.filter(function (s) { return counts[s]; })[0];
  var sevDetail = SEV.filter(function (s) { return counts[s]; }).map(function (s) { return h("span", { class: "sev-" + s }, h("b", { text: counts[s] + " " + s })); });
  var oos = allPkgs.filter(function (p) { return p.support && p.support.out_of_support; });
  function oosNames(list) {
    var seen = {}, names = [];
    list.forEach(function (p) { var n = (p.name + " " + (p.version || "")).trim(); if (!seen[n]) { seen[n] = 1; names.push(n); } });
    return names.slice(0, 5).join(", ") + (names.length > 5 ? " and " + (names.length - 5) + " more" : "");
  }
  var ic = R.summary.inventory_counts;
  var stats = [
    { n: total, label: "Vulnerabilities", cls: worst ? "attention sev-" + worst : "", detail: sevDetail.length ? sevDetail : [h("span", { text: "None found by the checks below" })] },
    { n: R.summary.out_of_support, label: "Out of support", cls: R.summary.out_of_support ? "attention st-end-of-life" : "",
      detail: oos.length ? [h("span", { text: oosNames(oos) })] : [h("span", { text: "Everything checked is supported or unknown" })] },
    { n: ic.libraries_direct + ic.libraries_transitive + ic.runtimes, label: "Packages and runtimes checked", cls: "",
      detail: [h("span", { text: ic.libraries_direct + " direct · " + ic.libraries_transitive + " transitive · " + plural(ic.runtimes, "runtime") })] }
  ];
  stats.forEach(function (s) {
    $("stats").append(h("div", { class: "card stat " + s.cls }, h("span", { class: "label", text: s.label }), h("span", { class: "n num", text: String(s.n) }), h("div", { class: "detail" }, s.detail)));
  });
  R.summary.top_actions.forEach(function (a) { $("actions").append(h("li", null, h("span", null, withRefs(a)))); });
  if (!R.summary.top_actions.length) $("actions").append(h("li", null, h("span", { class: "muted", text: "Nothing needs action." })));

  function dl(title, rows) {
    // Flatten the [dt, dd] pairs: h() only unwraps one level of arrays.
    var items = [];
    rows.forEach(function (r) { items.push(h("dt", null, r[0]), h("dd", { text: r[1] })); });
    return h("div", { class: "help-col" }, h("h3", { text: title }), h("dl", null, items));
  }
  $("help").append(
    dl("Severity", SEV.map(function (s) { return [pill(s), SEV_HELP[s]]; })),
    dl("Support status", STATUS.map(function (s) { return [statusEl({ status: s }), STATUS_HELP[s]]; })),
    dl("Is your code affected?", Object.keys(REACH).map(function (k) { return [h("span", { class: "reach-badge reach-" + k, text: REACH[k][0] }), REACH[k][1]]; })));

  // What was checked
  var cov = R.scan.coverage;
  var skipped = R.scan.scope.excluded_paths;
  $("scope-line").textContent = R.scan.scope.files_scanned + " files in scope · skipped " + (skipped.length ? skipped.join(", ") : "nothing");
  cov.checks_run.forEach(function (c) { $("checked").append(h("span", { class: "check-ok", text: CHECK_LABEL[c] || c })); });
  var gaps = [];
  if (R.scan.mode === "offline") gaps.push("Offline: vulnerabilities and support status not verified");
  (cov.gaps || []).forEach(function (g) { if (!(R.scan.mode === "offline" && /^Offline/.test(g))) gaps.push(g); });
  cov.tools_missing.forEach(function (t) { gaps.push(t + " not available"); });
  cov.ecosystems_unsupported.forEach(function (e) { gaps.push(e + " found but not analysed"); });
  R.scan.errors.forEach(function (e) { gaps.push(typeof e === "string" ? e : JSON.stringify(e)); });
  if (gaps.length) gaps.forEach(function (g) { $("checked").append(h("span", { class: "gap", text: g })); });
  else $("checked").append(h("span", { class: "muted", text: "No gaps: every planned check ran." }));
  $("tools").append(h("div", null, h("span", { class: "muted", text: "Tools and data sources: " }), cov.tools_used.map(function (t) { return t.name + (t.version ? " " + t.version : ""); }).join(" · ") || "none"));
  if ((cov.osv_scanned_files || []).length) $("tools").append(h("div", null, h("span", { class: "muted", text: "Files the osv-scanner scan read: " }),
    cov.osv_scanned_files.map(function (f) { return f.file + (f.packages != null ? " (" + plural(f.packages, "package") + ")" : ""); }).join(", ")));
  var opt = R.scan.options || {}, optText = [];
  if (opt.severity && opt.severity !== "info") optText.push("findings below " + opt.severity + " left out");
  if (opt.no_transitive) optText.push("direct dependencies only");
  if (opt.unmaintained_months) optText.push("unmaintained after " + opt.unmaintained_months + " months without a release");
  if (opt.fail_on) optText.push("CI fails on " + opt.fail_on + " or above");
  if ((opt.internal_patterns || []).length) optText.push("internal packages: " + opt.internal_patterns.join(", "));
  if (optText.length) $("tools").append(h("div", null, h("span", { class: "muted", text: "Options: " }), optText.join(" · ")));
  if ((R.scan.scope.osv_scanner_configs || []).length) $("tools").append(h("div", null, h("span", { class: "muted", text: "osv-scanner.toml files in the repository (read as data, not obeyed): " }),
    h("span", { class: "mono", text: R.scan.scope.osv_scanner_configs.join(", ") })));
  $("tools").append(h("div", null, h("span", { class: "muted", text: "Project path: " }), h("span", { class: "mono", text: R.target.path })));

  // Vulnerabilities
  var sevOn = {}; SEV.forEach(function (s) { sevOn[s] = true; });
  SEV.forEach(function (s) {
    var n = counts[s] || 0;
    var b = h("button", { type: "button", class: "toggle sev-" + s, "aria-pressed": n ? "true" : "false", disabled: n ? null : "disabled", text: cap(s) + " " + n });
    b.addEventListener("click", function () { sevOn[s] = !sevOn[s]; b.setAttribute("aria-pressed", String(sevOn[s])); renderFindings(); });
    $("sev-filters").append(b);
  });
  $("f-cat").append(h("option", { value: "", text: "All types" }));
  Object.keys(CAT_LABEL).forEach(function (c) {
    if (R.vulnerabilities.some(function (f) { return f.category === c; })) $("f-cat").append(h("option", { value: c, text: CAT_LABEL[c] }));
  });

  function fixHint(f, pkg) {
    if (f.advisory && f.status === "unverified") return null;
    if (f.advisory) return f.advisory.fixed_versions.length ? "Fix: upgrade to " + f.advisory.fixed_versions[0] + " or later"
      : (f.rule === "scanner-advisory" ? "Fixed version not given" : "No fixed version");
    if (f.category === "support" && pkg && pkg.support) return STATUS_LABEL[pkg.support.status] + (pkg.support.eol_date ? " since " + pkg.support.eol_date : "");
    return null;
  }
  function snippet(text, line, start) {
    var pre = h("pre", { class: "snippet" });
    text.split("\n").forEach(function (t, i) {
      var num = start ? start + i : null;
      pre.append(h("span", { class: "row" + (num && num === line ? " hit" : "") }, h("span", { class: "ln", text: num ? String(num) : "" }), t));
    });
    return pre;
  }
  function block(title) { return h("div", { class: "block" }, h("h3", { text: title }), Array.prototype.slice.call(arguments, 1)); }

  function findingEl(f) {
    var pkg = f.affected_package ? byId[f.affected_package] : null;
    var loc = f.location && f.location.file ? f.location.file + (f.location.line ? ":" + f.location.line : "") : "";
    var reach = f.reachability ? REACH[f.reachability.status] : null;
    var hint = fixHint(f, pkg);
    var summary = h("summary", null,
      pill(f.severity),
      h("span", { class: "f-title", text: f.title }),
      h("span", { class: "f-side" }, reach ? h("span", { class: "reach-badge reach-" + f.reachability.status, text: reach[0] }) : null, h("span", { class: "chev", "aria-hidden": "true" })),
      h("span", { class: "f-sub" },
        h("span", { class: "mono", text: pkg ? pkg.name + " " + (pkg.version || "") : loc }),
        hint ? h("span", { class: "fix-hint", text: hint }) : null,
        f.status === "unverified" ? h("span", { text: "Not verified (offline)" }) : null));

    var tech = [];
    function t(k, v) { if (v != null && v !== "") tech.push(h("dt", { text: k }), h("dd", null, v)); }
    t("Finding", h("span", { class: "mono", text: f.id }));
    t("Type", CAT_LABEL[f.category] || f.category);
    t("Rule", h("span", { class: "mono", text: f.rule }));
    if (f.advisory) {
      t("Advisory", f.advisory.ids.length ? h("span", { class: "links" }, f.advisory.ids.map(function (id) {
        return f.advisory.source === "osv.dev" && /^[A-Z][A-Z0-9]*-[A-Za-z0-9][A-Za-z0-9\-_:.]*$/.test(id) ? h("a", { href: "https://osv.dev/vulnerability/" + encodeURIComponent(id), target: "_blank", rel: "noopener", class: "mono", text: id }) : h("span", { class: "mono", text: id });
      })) : "None: not verified, so no advisory ID is given");
      t("Advisory source", f.advisory.source);
      if (f.advisory.affected_range) t("Affected versions", h("span", { class: "mono", text: f.advisory.affected_range }));
      if (f.status !== "unverified") t("Fixed in", h("span", { class: "mono", text: f.advisory.fixed_versions.join(", ") || (f.rule === "scanner-advisory" ? "Not given by the scanner" : "No fix released") }));
    }
    if (f.cvss) t("CVSS " + f.cvss.version, h("span", null, f.cvss.score != null ? h("b", { class: "num", text: Number(f.cvss.score).toFixed(1) }) : null, f.cvss.score != null ? " " : null, h("span", { class: "mono muted", style: "font-size:0.8rem", text: f.cvss.vector })));
    if (pkg) t("Installed", (pkg.scope ? cap(pkg.scope) + " dependency, " + (pkg.direct ? "direct" : "transitive") : "Runtime") + " · support: " + STATUS_LABEL[(pkg.support && pkg.support.status) || "unknown"]);
    t("Evidence", loc ? h("span", { class: "mono", text: loc }) : null);
    t("Weakness", f.cwe && f.cwe.length ? h("span", { class: "mono", text: f.cwe.join(", ") }) : null);
    t("Confidence", cap(f.confidence) + (f.status === "unverified" ? ", not verified" : ""));
    t("Found by", f.detected_by.join(", "));
    var refs = (f.references || []).map(safeUrl).filter(Boolean);
    t("References", refs.length ? h("span", { class: "links" }, refs.map(function (u) { return h("a", { href: u, target: "_blank", rel: "noopener", text: u.replace(/^https?:\/\//, "") }); })) : null);

    var body = h("div", { class: "f-body" },
      h("div", { class: "f-cols" },
        block("What's wrong", h("p", { text: f.description })),
        block("Is your code affected?",
          reach ? h("p", null, h("b", { class: "reach-badge reach-" + f.reachability.status, text: reach[0] + ". " }), f.reachability.evidence || reach[1])
                : h("p", { class: "muted", text: f.category === "support" ? "This is about the package as a whole, not one function." : "Not assessed." })),
        h("div", { class: "block fix" }, h("h3", { text: "How to fix" }), h("p", null, withRefs(f.remediation.summary)),
          h("p", { class: "muted small", text: "Effort: " + f.remediation.effort + " · Risk of breaking changes: " + f.remediation.breaking_change_risk })),
        block("Why it's " + f.severity, h("p", null, withRefs(f.severity_rationale)))),
      f.location && f.location.snippet ? snippet(f.location.snippet, f.location.line, f.location.snippet_start_line) : null,
      h("div", { class: "tech" }, h("dl", null, tech)));
    return h("details", { class: "finding sev-" + f.severity, id: f.id }, summary, body);
  }

  var sorted = R.vulnerabilities.slice().sort(function (a, b) {
    return SEV_RANK[a.severity] - SEV_RANK[b.severity] || CONF_RANK[a.confidence] - CONF_RANK[b.confidence] || a.id.localeCompare(b.id);
  });
  var findingEls = {};
  sorted.forEach(function (f) { findingEls[f.id] = findingEl(f); });
  function haystack(f) {
    var p = f.affected_package ? byId[f.affected_package] : null;
    return [f.id, f.title, p ? p.name : "", f.location && f.location.file, (f.cwe || []).join(" "), f.advisory ? f.advisory.ids.join(" ") : ""].join(" ").toLowerCase();
  }
  function renderFindings() {
    var cat = $("f-cat").value, q = $("f-search").value.trim().toLowerCase(), list = $("findings"), shown = 0;
    list.textContent = "";
    sorted.forEach(function (f) {
      if (!sevOn[f.severity] || (cat && f.category !== cat) || (q && haystack(f).indexOf(q) === -1)) return;
      list.append(findingEls[f.id]); shown++;
    });
    if (!shown) list.append(h("div", { class: "card empty", text: sorted.length ? "No vulnerabilities match these filters." : "No vulnerabilities were found by the checks listed above." }));
    $("find-count").textContent = shown === sorted.length ? plural(sorted.length, "finding") : shown + " of " + sorted.length + " shown";
  }
  ["f-cat", "f-search"].forEach(function (id) { $(id).addEventListener("input", renderFindings); });

  function openFinding(id) {
    var el = findingEls[id];
    if (!el) return;
    if (!el.isConnected) {
      SEV.forEach(function (s) { sevOn[s] = true; });
      document.querySelectorAll("#sev-filters button:not([disabled])").forEach(function (b) { b.setAttribute("aria-pressed", "true"); });
      $("f-cat").value = ""; $("f-search").value = ""; renderFindings();
    }
    el.open = true;
    el.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  }
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest("[data-open]");
    if (!a) return;
    e.preventDefault();
    openFinding(a.getAttribute("data-open"));
    try { history.replaceState(null, "", "#" + a.getAttribute("data-open")); } catch (_) {}
  });

  // Dependencies
  $("inv-line").textContent = "Languages: " + R.inventory.languages.map(function (l) { return l.name; }).join(", ") + ". Support status comes from endoflife.date, the package registries and the projects' own policies.";
  var sc = R.summary.support_counts, scTotal = 0;
  STATUS.forEach(function (s) { scTotal += sc[s] || 0; });
  STATUS.forEach(function (s) {
    var n = sc[s] || 0;
    if (n) $("support-bar").append(h("span", { class: "st-" + s, style: "flex:" + n, title: n + " " + STATUS_LABEL[s] }));
    $("legend").append(h("span", { class: n ? "" : "zero", title: STATUS_HELP[s] }, statusEl({ status: s }), " ", h("b", { text: String(n) })));
  });
  $("support-bar").setAttribute("aria-label", STATUS.map(function (s) { return (sc[s] || 0) + " " + STATUS_LABEL[s]; }).join(", ") + " of " + scTotal);

  function techCard(item, kind) {
    var s = item.support || {};
    return h("div", { class: "card tech-card" + (s.out_of_support ? " oos" : "") },
      h("span", { class: "label", text: kind }),
      h("div", { class: "top" }, h("span", { class: "name", text: item.name }), h("span", { class: "mono", text: (item.version || "unknown") + (item.version_confidence === "range" ? ".x" : "") })),
      statusEl(s),
      s.reason ? h("p", { class: "why", text: s.reason }) : null,
      h("p", { class: "where", text: "Found in " + item.evidence.join(", ") }));
  }
  R.inventory.runtimes.forEach(function (r) { $("tech-cards").append(techCard(r, "Runtime")); });
  R.inventory.frameworks.forEach(function (f) { $("tech-cards").append(techCard(f, "Framework · " + f.category.replace(/-/g, " "))); });

  var scopes = [];
  R.inventory.libraries.forEach(function (l) { if (l.scope && scopes.indexOf(l.scope) < 0) scopes.push(l.scope); });
  scopes.forEach(function (s) { $("lib-scope").append(h("option", { value: s, text: cap(s) })); });

  var libCols = [{ key: "name", label: "Package" }, { key: "version", label: "Version" }, { key: "support", label: "Support" }, { key: "license", label: "License" }, { key: "vulns", label: "Findings" }];
  var libSort = { key: "attention", dir: 1 };
  libCols.forEach(function (c) {
    var b = h("button", { type: "button", text: c.label });
    b.addEventListener("click", function () { libSort = { key: c.key, dir: libSort.key === c.key ? -libSort.dir : (c.key === "vulns" ? -1 : 1) }; renderLibs(); });
    $("lib-head").append(h("th", { "data-key": c.key, "aria-sort": "none" }, b));
  });
  function needsAttention(l) { return l.vulnerability_ids.length > 0 || (l.support && l.support.out_of_support); }
  function libVal(l, k) {
    if (k === "attention") return (needsAttention(l) ? 0 : 1) * 100 + STATUS.indexOf((l.support && l.support.status) || "unknown");
    if (k === "support") return STATUS.indexOf((l.support && l.support.status) || "unknown");
    if (k === "vulns") return l.vulnerability_ids.length;
    return String(l[k] || "").toLowerCase();
  }
  function renderLibs() {
    var q = $("lib-search").value.trim().toLowerCase(), show = $("lib-show").value, scope = $("lib-scope").value;
    var rows = R.inventory.libraries.filter(function (l) {
      return (show === "all" || (show === "direct" && l.direct) || (show === "attention" && needsAttention(l))) &&
             (!scope || l.scope === scope) && (!q || (l.name + " " + l.version + " " + (l.license || "")).toLowerCase().indexOf(q) > -1);
    }).sort(function (a, b) {
      var x = libVal(a, libSort.key), y = libVal(b, libSort.key);
      return (x < y ? -1 : x > y ? 1 : 0) * libSort.dir || a.name.localeCompare(b.name);
    });
    document.querySelectorAll("#lib-head th").forEach(function (th) {
      var on = th.dataset.key === libSort.key;
      th.setAttribute("aria-sort", on ? (libSort.dir > 0 ? "ascending" : "descending") : "none");
      th.querySelector("button").textContent = libCols.filter(function (c) { return c.key === th.dataset.key; })[0].label + (on ? (libSort.dir > 0 ? " ↑" : " ↓") : "");
    });
    var body = $("lib-body"); body.textContent = "";
    rows.forEach(function (l) {
      var st = (l.support && l.support.status) || "unknown";
      var sub = [cap(l.scope), l.direct ? "direct" : "transitive" + (l.introduced_by.length ? " via " + l.introduced_by.join(" → ") : ""),
        l.workspace ? "in " + l.workspace : null, l.vendored ? "vendored file" : null, l.private ? "private" : null,
        (l.found_by || []).length ? "found only by " + l.found_by.join(", ") : null].filter(Boolean).join(" · ");
      body.append(h("tr", { class: needsAttention(l) ? "attn " + (l.vulnerability_ids.length ? "sev-high" : "st-" + st) : null },
        h("td", null, h("div", { class: "mono", text: l.name }), h("div", { class: "sub", text: sub })),
        h("td", { class: "mono", text: (l.version || "unknown") + (l.version_confidence === "range" ? " (declared range)" : "") }),
        h("td", { title: (l.support && l.support.reason) || "" }, statusEl(l.support)),
        h("td", { text: l.license || "Unknown" }),
        h("td", null, l.vulnerability_ids.length ? h("span", { class: "links" }, l.vulnerability_ids.map(function (id) { return h("a", { href: "#" + id, class: "ref", "data-open": id, text: id }); })) : h("span", { class: "muted", text: "None" }))));
    });
    if (!rows.length) body.append(h("tr", null, h("td", { colspan: "5", class: "empty", text: "No packages match these filters." })));
    $("lib-count").textContent = rows.length + " of " + R.inventory.libraries.length + " packages";
  }
  ["lib-search", "lib-show", "lib-scope"].forEach(function (id) { $(id).addEventListener("input", renderLibs); });

  // Suppressed
  R.suppressed.forEach(function (s) {
    var what = [s.finding_id, s.advisory_id, s.rule].filter(Boolean).join(" · ");
    $("suppressed").append(h("tr", null, h("td", null, h("div", { text: s.title || s.advisory_id || s.rule }), h("div", { class: "sub mono", text: what })),
      h("td", { class: "mono", text: s.affected_package || "" }),
      h("td", { class: "mono", text: s.location && s.location.file ? s.location.file + (s.location.line ? ":" + s.location.line : "") : "" }), h("td", { text: s.reason })));
  });
  if (!R.suppressed.length) $("suppressed").append(h("tr", null, h("td", { class: "muted", colspan: "4", text: "Nothing was suppressed." })));
  $("h-suppressed").textContent = "Suppressed findings (" + R.suppressed.length + ")";

  // Footer
  [["Report", R.report_id], ["Schema", R.schema_version], ["Tool", R.tool.name + " " + R.tool.version], ["Model", R.tool.agent_model], ["Data", __DATA_FILE__]]
    .forEach(function (f) { $("footer").append(h("span", null, f[0] + " ", h("span", { class: "mono", text: f[1] }))); });

  // Print with every finding open.
  window.addEventListener("beforeprint", function () { Object.keys(findingEls).forEach(function (k) { findingEls[k].open = true; }); });

  renderLibs();
  renderFindings();
  if (/^#F-\d{3,}$/.test(location.hash)) openFinding(location.hash.slice(1));
  window.addEventListener("hashchange", function () { if (/^#F-\d{3,}$/.test(location.hash)) openFinding(location.hash.slice(1)); });
})();
</script>
</body>
