<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="acme" value="https://pkgs.acme.internal/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="acme">
      <package pattern="Acme.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <acme>
      <add key="Username" value="build-agent" />
      <add key="ClearTextPassword" value="s3cr3t-Feed-Passw0rd-2024!" />
    </acme>
  </packageSourceCredentials>
</configuration>
